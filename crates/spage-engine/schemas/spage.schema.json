{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spage.me/schemas/spage.schema.json",
  "title": "Spage project resource declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["requires", "core", "plugins"],
  "properties": {
    "requires": {
      "type": "string",
      "minLength": 1,
      "description": "Semantic version range accepted for spage-engine."
    },
    "core": {
      "$ref": "#/$defs/packageSpec",
      "pattern": "^@s-page/core@"
    },
    "plugins": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/packageSpec"
      }
    }
  },
  "$defs": {
    "packageSpec": {
      "type": "string",
      "pattern": "^(?:@[A-Za-z0-9._-]+/[A-Za-z0-9._-]+|[A-Za-z0-9._-]+)@[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "description": "An npm package name followed by an exact semantic version."
    }
  }
}
